# Cache rules for Netlify and Cloudflare Pages (other hosts ignore this file).
# Photos rarely change; the page and catalogue must update quickly after an edit.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/catalog.js
  Cache-Control: public, max-age=300, must-revalidate
/visit.js
  Cache-Control: public, max-age=300, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/stock.json
  Cache-Control: public, max-age=0, must-revalidate

# Sitemaps are for search engines to read, not to list as results.
/sitemap.xml
  X-Robots-Tag: noindex
/sitemap-products.xml
  X-Robots-Tag: noindex

# Security headers. The inline script is allowed by its hash: after editing the <script> in
# index.html, run `python3 tadaboo/scripts/csp_hash.py` or the live shop will stop working.
# Website orders load the WebsitePublisher form client (cdn.) and post to its API.
# Razorpay Checkout: its script (checkout.), its payment frame (api.) and its logging (lumberjack.).
# Inline style attributes are used by the page, so style-src needs 'unsafe-inline'.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.websitepublisher.ai https://checkout.razorpay.com 'sha256-q4hN9wuOW3+WmKmvYoepwZ+meNWuprwtR99JFZEYsys='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; connect-src 'self' https://tadaboo-orders.bsharma-04.workers.dev https://api.razorpay.com https://lumberjack.razorpay.com https://api.websitepublisher.ai https://*.websitepublisher.ai; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
